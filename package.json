  "bugs": {
    "url": "https://github.com/wenta/rapid-dominance/issues"
  },
  "homepage": "https://github.com/wenta/rapid-dominance#readme",
  "devDependencies": {
    "live-server": "^1.2.2",
    "phaser": "^3.90.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
