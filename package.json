{
  "name": "Rapid Dominance",
  "version": "0.2.3",
  "description": "A turn-based territory strategy game inspired by Enemy Flag.",
  "main": "webpack.config.js",
  "scripts": {
    "build": "webpack --mode production",
    "test": "tsc --ignoreConfig --noImplicitAny false --outDir /tmp/rapid-dominance-tests --module commonjs --target es2020 tests/rules.test.ts && node /tmp/rapid-dominance-tests/tests/rules.test.js",
    "start": "webpack --watch --mode development & live-server --port=8085"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenta/rapid-dominance.git"
  },
  "keywords": [],
